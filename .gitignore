test-results/

# Operator-supplied staff rosters. Real auth.users ids never enter the repository;
# see supabase/operations/roster/README.md.
supabase/operations/roster/*.local.json

# Written by `deno check` (npm run typecheck:api) whenever the API boundary is
# checked locally. It is a byproduct of running the checker, not source: the
# edge functions pin their own versions in the import specifiers themselves
# (`jsr:@supabase/supabase-js@2.49.8`), and the Supabase CLI resolves them at
# deploy time. Committing this would newly pin dependency resolution for the
# deploy — a production change, and not one type-checking needs.
supabase/functions/deno.lock

# Supabase CLI scratch state. Regenerated by `supabase link`, machine-specific,
# and the wrong place for anything to be durable. The project this repository
# targets is declared in `supabase/config.toml` (`project_id`), which is tracked
# on purpose; `.temp` is a cache of what the CLI last saw, and a cache of what a
# CLI last saw is how a credential eventually ends up in a commit.
supabase/.temp/
