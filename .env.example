# Copy to .env.local and fill in your Supabase project values.
# Current project (cortex): https://oqybniefkbppptfatoae.supabase.co
# Dashboard: https://supabase.com/dashboard/project/oqybniefkbppptfatoae/settings/api

# Project URL
VITE_SUPABASE_URL=https://oqybniefkbppptfatoae.supabase.co

# Publishable key from Supabase Dashboard → API (sb_publishable_* or legacy anon JWT)
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Optional: project ref if you prefer not to paste the full URL
# VITE_SUPABASE_PROJECT_ID=

# Edge function name (default matches Figma Make deploy)
# VITE_SUPABASE_EDGE_FUNCTION=make-server-324f4fbe

# Flip to true once the edge function is deployed and reachable
VITE_BACKEND_INTEGRATION=false

# Dev helpers
# VITE_SHOW_API_ERRORS=true
# VITE_VERBOSE_LOGGING=true
# VITE_API_TIMEOUT=30000


# ============================================================================
# AI CONTROL PLANE — Supabase Edge Function secrets (AI-01 Batch 1)
#
# These are SERVER-side secrets. Set them in the Supabase dashboard under
# Edge Functions → Secrets, never in this file and never with a VITE_ prefix —
# anything VITE_ is compiled into the browser bundle.
#
# Every value below is optional and bounded: a missing or malformed setting
# falls back to the documented default rather than propagating into the request
# path. The platform runs correctly with none of them set, provided at least one
# provider credential is configured.
# ============================================================================

# ── Provider credentials ────────────────────────────────────────────────────
# At least one is required in production. A provider with no key is skipped by
# the selector rather than failing — that is how a provider is turned on or off
# without a deploy. With none set, GET /ai/health reports unhealthy.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Provider selection and failover ─────────────────────────────────────────
# AI_PROVIDER_PREFERENCE=openai,anthropic,mock
# AI_FALLBACK_PROVIDER=
# AI_FAILOVER_ENABLED=true

# ── Circuit breaker ─────────────────────────────────────────────────────────
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_OPEN_MS=30000
# AI_CIRCUIT_HALF_OPEN_SUCCESSES=2

# ── Retry backoff ───────────────────────────────────────────────────────────
# AI_RETRY_BASE_DELAY_MS=250
# AI_RETRY_MAX_DELAY_MS=4000
# AI_RETRY_JITTER_PERCENT=20

# ── Budget (micro-USD; 1_000_000 = $1.00) ───────────────────────────────────
# AI_BUDGET_ORG_DAILY_MICRO_USD=50000000
# AI_BUDGET_ACTOR_DAILY_MICRO_USD=5000000
# AI_BUDGET_ALERT_PERCENT=80
# AI_BUDGET_ENFORCE=true

# ── Audit ───────────────────────────────────────────────────────────────────
# Durable records are written to KV under org:{id}:ai:audit:{date}:{auditId}.
# They store SHA-256 digests of the prompt and completion, never their text.
# AI_AUDIT_DURABLE=true
# AI_AUDIT_RETENTION_DAYS=400
# AI_AUDIT_BUFFER_SIZE=200

# ── Observability ───────────────────────────────────────────────────────────
# AI_LOG_LEVEL=info
# AI_STRUCTURED_LOGS=true
# AI_METRICS_BUFFER_SIZE=500

# ── Governance ──────────────────────────────────────────────────────────────
# Turning redaction off is a deliberate, audited choice: prompts would then
# reach the model provider with client PII intact.
# AI_REDACTION_ENABLED=true
# AI_STRICT_INPUT_GUARD=false

# ── Tenancy ─────────────────────────────────────────────────────────────────
# AI_DEFAULT_ORGANIZATION_ID=marq-cortex
# AI_ORGANIZATION_ALLOW_LIST=

# ── Local development ───────────────────────────────────────────────────────
# Registers the deterministic mock provider so the platform runs end to end with
# no vendor credentials. It is declared non-production, so a deployment where it
# is the only usable provider reports degraded rather than healthy.
# AI_ENABLE_MOCK_PROVIDER=false
