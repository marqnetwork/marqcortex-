# Copy to .env.local and fill in your Supabase project values.
# Current project (cortex): https://oqybniefkbppptfatoae.supabase.co
# Dashboard: https://supabase.com/dashboard/project/oqybniefkbppptfatoae/settings/api

# Project URL
VITE_SUPABASE_URL=https://oqybniefkbppptfatoae.supabase.co

# Publishable key from Supabase Dashboard → API (sb_publishable_* or legacy anon JWT)
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Optional: project ref if you prefer not to paste the full URL
# VITE_SUPABASE_PROJECT_ID=

# Edge function name (default matches Figma Make deploy)
# VITE_SUPABASE_EDGE_FUNCTION=make-server-324f4fbe

# Flip to true once the edge function is deployed and reachable
VITE_BACKEND_INTEGRATION=false

# Dev helpers
# VITE_SHOW_API_ERRORS=true
# VITE_VERBOSE_LOGGING=true
# VITE_API_TIMEOUT=30000


# ============================================================================
# AI CONTROL PLANE — Supabase Edge Function secrets (AI-01 Batch 1)
#
# These are SERVER-side secrets. Set them in the Supabase dashboard under
# Edge Functions → Secrets, never in this file and never with a VITE_ prefix —
# anything VITE_ is compiled into the browser bundle.
#
# Every value below is optional and bounded: a missing or malformed setting
# falls back to the documented default rather than propagating into the request
# path. The platform runs correctly with none of them set, provided at least one
# provider credential is configured.
# ============================================================================

# ── SPENDING CONTROLS — read this section first ─────────────────────────────
#
# Two independent switches stand between this platform and a model vendor bill,
# and BOTH are safe by default. A deployment that sets nothing in this file
# serves synthetic completions from the mock provider and cannot spend money.
#
#   1. AI_ALLOW_REAL_REQUESTS   the kill switch. FALSE by default.
#   2. AI_MAX_SPEND_USD         the lifetime ceiling. $9 by default.
#
# Setting a provider API key is deliberately NOT enough to start spending. A key
# present in the environment with the kill switch off is refused at the provider
# selector, and GET /ai/health reports the switch as the reason.

# The kill switch. While false, every provider that charges money is removed
# from selection — not skipped at call time, removed from the eligible set, so
# the refusal is visible in the health endpoint rather than discovered by a bill.
# AI_ALLOW_REAL_REQUESTS=false

# The MARQ-funded lifetime ceiling, in DOLLARS. Accepts decimals (2.50).
#
# This is a lifetime cap, not a monthly one: it does NOT reset on a timer, on a
# deploy, or on an isolate restart. When cumulative spend reaches it, AI features
# stop until somebody with authority raises it. Clearing it requires an
# authorising actor and a written reason, both recorded on the ledger.
#
# A malformed or negative value falls back to 9 rather than to "no limit" — a
# typo in a spending cap must never widen it.
# AI_MAX_SPEND_USD=9

# Persist the ledger to the key-value store. Leave this on: with it off the
# ceiling is isolate-local, and a recycled Supabase edge isolate rediscovers a
# $0 balance, which is the exact failure the ceiling exists to prevent.
# AI_SPEND_DURABLE=true

# Refuse requests at the ceiling. Off records spend but does not enforce it —
# only appropriate for a deliberate, time-boxed investigation.
# AI_SPEND_ENFORCE=true

# How long a spend reservation holds its headroom before another isolate may
# reclaim it. A request whose isolate is recycled before settlement would
# otherwise hold that money forever. The floor is twice the workflow deadline,
# applied in code — a hold must outlive the request that owns it, so a value
# below that floor is raised rather than honoured.
# AI_SPEND_RESERVATION_TTL_MS=900000

# ── Provider credentials ────────────────────────────────────────────────────
# Required in production, and NOT sufficient on their own — see the kill switch
# above. A provider with no key is skipped by the selector rather than failing,
# which is how a provider is turned on or off without a deploy.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Provider selection and failover ─────────────────────────────────────────
# Mock is first by default. Once real requests are authorised, the mock is still
# registered but is declared non-production, so a deployment serving on it
# reports `degraded` rather than `healthy` — a green light while every completion
# is synthetic is the most dangerous state a health endpoint can report.
# Default follows the kill switch: mock-first while real requests are off,
# mock-LAST once they are authorised. Setting this explicitly overrides both.
# AI_PROVIDER_PREFERENCE=mock,openai,anthropic
# AI_FALLBACK_PROVIDER=
# AI_FAILOVER_ENABLED=true
# AI_ENABLE_MOCK_PROVIDER=true

# Refuse a provider whose certification has not been established. An
# `unverified` adapter has never been shown to work against this platform's
# contract, and production traffic is not the place to find out.
# AI_REQUIRE_CERTIFIED_PROVIDERS=true

# ── Agent runtime (AI-01 Batch 3A) ──────────────────────────────────────────
#
# Register the deterministic in-process agent tools. OFF by default and
# deliberately so: a tool nobody asked for is a capability nobody reviewed, and
# a real deployment's tool registry should be empty until real tools exist.
# The agent runtime takes no credentials and no provider settings of its own —
# it executes every model step through the AI Control Plane, so the variables
# above are what govern it.
# AGENT_MOCK_TOOLS_ENABLED=false

# Whole-workflow deadline, covering every attempt against every provider.
# Distinct from the per-attempt timeout, which bounds one call.
# AI_WORKFLOW_DEADLINE_MS=90000

# ── Circuit breaker ─────────────────────────────────────────────────────────
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_OPEN_MS=30000
# AI_CIRCUIT_HALF_OPEN_SUCCESSES=2

# ── Retry backoff ───────────────────────────────────────────────────────────
# AI_RETRY_BASE_DELAY_MS=250
# AI_RETRY_MAX_DELAY_MS=4000
# AI_RETRY_JITTER_PERCENT=20

# ── Budget (micro-USD; 1_000_000 = $1.00) ───────────────────────────────────
# AI_BUDGET_ORG_DAILY_MICRO_USD=50000000
# AI_BUDGET_ACTOR_DAILY_MICRO_USD=5000000
# AI_BUDGET_ALERT_PERCENT=80
# AI_BUDGET_ENFORCE=true

# ── Audit ───────────────────────────────────────────────────────────────────
# Durable records are written to KV under org:{id}:ai:audit:{date}:{auditId}.
# They store SHA-256 digests of the prompt and completion, never their text.
# AI_AUDIT_DURABLE=true
# AI_AUDIT_RETENTION_DAYS=400
# AI_AUDIT_BUFFER_SIZE=200

# ── Observability ───────────────────────────────────────────────────────────
# AI_LOG_LEVEL=info
# AI_STRUCTURED_LOGS=true
# AI_METRICS_BUFFER_SIZE=500

# ── Governance ──────────────────────────────────────────────────────────────
# Turning redaction off is a deliberate, audited choice: prompts would then
# reach the model provider with client PII intact.
# AI_REDACTION_ENABLED=true
# AI_STRICT_INPUT_GUARD=false

# ── Tenancy ─────────────────────────────────────────────────────────────────
#
# An AI request resolves its organization from a membership the identity provider
# confirms the caller holds. A caller with no membership FAILS CLOSED by default.
#
# A single-tenant console deployment legitimately needs a fallback, and
# AI_ALLOW_DEFAULT_ORGANIZATION provides one — but a request resolved that way is
# marked `membershipVerified: false` all the way into its audit record. That
# distinction matters: "tenant isolation enforced" and "everything landed in the
# default bucket because nobody has a membership row yet" produce
# identical-looking audit trails unless the difference is recorded, and only one
# of them is an isolation guarantee. Do not enable this and then describe the
# result as tenant isolation.
# AI_ALLOW_DEFAULT_ORGANIZATION=false
# AI_DEFAULT_ORGANIZATION_ID=marq-cortex
# AI_ORGANIZATION_ALLOW_LIST=

# ═══════════════════════════════════════════════════════════════════════════
# AI ADMINISTRATION — AI-01 Batch 2
# ═══════════════════════════════════════════════════════════════════════════
#
# There are no new environment variables for the administration layer, and that
# is the design rather than an omission.
#
# Everything above states what this DEPLOYMENT permits. The administration layer
# manages what is currently IN EFFECT — the AI master switch, the emergency kill
# switch, the default provider, the provider order, the model allow list, the
# retry curve, the workflow deadline and the rolling daily budgets — through an
# authorised console, persisted at the key-value key `ai:admin:settings` and
# versioned by `configurationVersion`.
#
# THE ONE-WAY RULE. Administrative action may tighten this platform's posture
# freely and may loosen it only inside the envelope this file already granted.
# `AI_ALLOW_REAL_REQUESTS=false` therefore cannot be overturned from a console:
# the effective value is the AND of the permission set here and the
# administrator's choice. An administrator can always turn real requests OFF —
# that is the kill switch and it must work instantly — and can only turn them ON
# if this file has already said yes.
#
# Which means: a value changed here takes effect on the next isolate and is the
# CEILING; a value changed in the console takes effect on the next request and
# is the current position underneath it. Lowering AI_MAX_SPEND_USD here is
# honoured on the next ledger read even if a console previously raised the cap,
# because a deployment decision outranks an operational one.
#
# Two settings above are worth re-reading in that light:
#
#   AI_AUDIT_DURABLE   Off makes the administrative change trail isolate-local.
#                      "Who engaged the kill switch and why" would then survive
#                      only until the next deploy.
#
#   AI_SPEND_DURABLE   Off makes the spend ceiling isolate-local, so an
#                      authorised cap increase is rediscovered as the
#                      environment default after a restart.
