{
  // ────────────────────────────────────────────────────────────────────────
  // Frontend boundary — Vite / browser / React 18.
  //
  // Covers src/ (the React application) plus utils/, which the frontend imports
  // via the root-absolute `/utils/*` specifier that Vite resolves from the
  // project root. Type-check only (noEmit); Vite owns transpilation.
  // ────────────────────────────────────────────────────────────────────────
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Vite env (`import.meta.env`, `*.css`, static asset modules) + React globals
    // (the JSX namespace) — the browser boundary. Node globals are excluded.
    "types": ["vite/client", "react", "react-dom"],

    // Path mapping mirrors the active Vite aliases exactly. No baseUrl — paths
    // resolve relative to this file (TS 5.x), and TS 6 deprecates baseUrl.
    "paths": {
      "@/*": ["./src/*"],
      "/utils/*": ["./utils/*"]
    },

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true
  },
  "include": ["src", "utils"]
}
